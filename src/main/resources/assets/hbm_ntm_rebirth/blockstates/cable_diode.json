{
  "multipart": [
    {
      "apply": { "model": "hbm_ntm_rebirth:block/cable_diode" }
    },
    {
      "when": { "north": "true" },
      "apply": { "model": "hbm_ntm_rebirth:block/red_cable_arm_north" }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "hbm_ntm_rebirth:block/red_cable_arm_east" }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "hbm_ntm_rebirth:block/red_cable_arm_south" }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "hbm_ntm_rebirth:block/red_cable_arm_west" }
    },
    {
      "when": { "up": "true" },
      "apply": { "model": "hbm_ntm_rebirth:block/red_cable_arm_up" }
    },
    {
      "when": { "down": "true" },
      "apply": { "model": "hbm_ntm_rebirth:block/red_cable_arm_down" }
    }
  ]
}
